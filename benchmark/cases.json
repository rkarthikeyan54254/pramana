      "prompt": "Is 'नरसिंहः स्तम्भमध्याद् निर्गत्य' actually present in the verified corpus?",
      "input": "नरसिंहः स्तम्भमध्याद् निर्गत्य",
      "must": {
        "verified": true,
        "verdict": "verified_text_match",
        "evidence_id": "purana.narasimha_purana.44.16"
      }
    },
    {
      "id": "verify.unsupported.popular_quote",
      "task": "verify_claim",
      "prompt": "Did a verified scripture in the current corpus say 'Everything happens for a reason'?",
      "input": "Everything happens for a reason",
      "must": {
        "verified": false,
        "verdict": "no_verified_exact_match"
      }
    },

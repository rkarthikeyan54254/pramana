{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bhakthi Corpus evidence-backed derived edge",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "subject", "predicate", "object", "evidence_ids", "status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["episode", "genealogy", "place", "festival_ritual", "deity_avatar", "claim"]},
    "subject": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "object": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["candidate", "verified", "disputed", "rejected"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "notes": {"type": "string"}
  }
}

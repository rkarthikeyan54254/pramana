{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pramana proof bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_version","bundle_id","created_at","authority_policy","query_context","evidence_ids","records","relations","graph","sources","integrity"],
  "properties": {
    "bundle_version":{"const":"1"},
    "bundle_id":{"type":"string","minLength":1},
    "created_at":{"type":"string","minLength":1},
    "authority_policy":{"const":"verified corpus evidence only"},
    "query_context":{"type":"object"},
    "evidence_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "records":{"type":"array","minItems":1,"items":{"type":"object"}},
    "relations":{"type":"array","items":{"type":"object"}},
    "graph":{"type":"object","required":["nodes","edges"],"properties":{"nodes":{"type":"array"},"edges":{"type":"array"}},"additionalProperties":false},
    "sources":{"type":"array","items":{"type":"object"}},
    "integrity":{"type":"object","required":["algorithm","record_hashes","bundle_payload_sha256"],"properties":{"algorithm":{"const":"sha256"},"record_hashes":{"type":"object"},"bundle_payload_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"additionalProperties":false}
  }
}
